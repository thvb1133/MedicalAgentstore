{
  "name": "medical-agent-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A marketplace/catalog of medical AI agents.",
  "license": "MIT",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "lint": "eslint .",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  }
}
