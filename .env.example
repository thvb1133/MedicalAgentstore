# Copy to .env.local and fill in what you have.
#
# None of this is needed to measure anything. The camera vitals, the voice
# acoustics, the alertness and tremor engines and the signing all run in the
# browser and never had a key. What these add is the conversation, the neural
# voice, and history that follows you between machines.
#
# Every value is trimmed on the way in, so a stray space from a paste will not
# quietly break the signature and leave you reading an IAM policy.

# Claude: the companion's replies, and the plain-language interpretation.
ANTHROPIC_API_KEY=

# Optional. Defaults to Sonnet, which is the right trade-off here.
# CLAUDE_MODEL=

# Amazon Polly: the neural voice. Without it the browser's own synthesiser
# speaks instead, which is free, offline and noticeably worse.
#
# The prefix is not decoration. On Amplify, Lambda or anything else running
# under an execution role, AWS_ACCESS_KEY_ID and its siblings already belong
# to that role, so an app reading the plain names signs requests as the
# platform rather than as you. These cannot collide, and take precedence over
# the plain names, which still work locally.
SANJIVANI_AWS_ACCESS_KEY_ID=
SANJIVANI_AWS_SECRET_ACCESS_KEY=
# A region Polly serves, for example us-east-1. No default: a
# guessed region fails on another continent for reasons that look nothing
# like a wrong region.
SANJIVANI_AWS_REGION=

# Optional. Leave empty to keep measurement history in this browser only.
# Needs the AWS credentials above as well.
SANJIVANI_SESSION_BUCKET=
